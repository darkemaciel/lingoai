# Database
POSTGRES_USER=lingoai
POSTGRES_PASSWORD=lingoai
POSTGRES_DB=lingoai

# AI provider (research.md §1). Leave AI_PROVIDER=local to use the deterministic
# LocalModelAdapter — no external key needed, sufficient for every quickstart.md
# scenario except "swap provider".
AI_PROVIDER=local
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Auth (research.md §10)
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
